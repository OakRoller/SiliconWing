diff --git a/src/nvidia/generated/g_mem_desc_nvoc.h b/src/nvidia/generated/g_mem_desc_nvoc.h
index cdee92f..899100c 100644
--- a/src/nvidia/generated/g_mem_desc_nvoc.h
+++ b/src/nvidia/generated/g_mem_desc_nvoc.h
@@ -1309,6 +1309,17 @@ memdescGetRootOffset(PMEMORY_DESCRIPTOR pMemDesc)
 static inline NvU32
 memdescGetCpuCacheAttrib(MEMORY_DESCRIPTOR *pMemDesc)
 {
+#if defined(NV_DARWIN) && defined(__aarch64__)
+    //
+    // NV_DARWIN on Apple Silicon: PCIe DMA is IO-coherent, and the memory fabric PANICS the machine on a
+    // No-Snoop read that hits a line a CPU holds (AMCC "UNEXP_RT_HIT_DIR", cmd ncrdincr_ro). System memory
+    // is therefore always CACHED to the RM: coherent GMMU aperture (kgmmuGetMemAperture, the DMA mapper),
+    // coherent CE phys mode (channel_utils) and coherent GSP DMA target. The OS layer maps every RAM page
+    // cacheable to match (os-xnu.cpp, nv_alloc_pages), whatever cache type the RM asked for.
+    //
+    if (pMemDesc->_addressSpace == ADDR_SYSMEM)
+        return 0; /* NV_MEMORY_CACHED: nvos.h is not in every translation unit this header reaches */
+#endif
     return pMemDesc->_cpuCacheAttrib;
 }
 
